# Environment variables (contains sensitive API keys — NEVER commit this)
.env
.env.local
.env.*.local

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright/Browser state, traces, and logs
logs/*
!logs/.gitkeep
screenshots/*
!screenshots/.gitkeep
*.log

# Persistent browser user profile and cache
user_data/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
