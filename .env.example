# Website Automation Agent — Environment Configuration
# Copy this file to ".env" and fill in your actual API keys to enable AI-powered parsing automatically.

# Google Gemini (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (from https://openrouter.ai/)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Grok / xAI (from https://x.ai/)
# GROK_API_KEY=your_grok_api_key_here
